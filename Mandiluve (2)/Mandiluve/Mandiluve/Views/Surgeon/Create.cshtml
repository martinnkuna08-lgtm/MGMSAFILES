@model Mandiluve.Models.Patient
@inject IHttpContextAccessor httpContextAccessor
<!DOCTYPE html>
<html lang="en">

<!-- Mirrored from dreamguys.co.in/demo/doccure/admin/form-basic-inputs.html by HTTrack Website Copier/3.x [XR&CO'2014], Sat, 30 Nov 2019 04:12:54 GMT -->
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
	<title>Doccure - Patient List Page</title>

	<!-- Favicon -->
	<link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.png">

	<!-- Bootstrap CSS -->
	<link rel="stylesheet" href="~/assets/css/bootstrap.min.css">

	<!-- Fontawesome CSS -->
	<link rel="stylesheet" href="~/assets/css/font-awesome.min.css">

	<!-- Feathericon CSS -->
	<link rel="stylesheet" href="~/assets/css/feathericon.min.css">

	<!-- Datatables CSS -->
	<link rel="stylesheet" href="~/assets/plugins/datatables/datatables.min.css">

	<!-- Main CSS -->
	<link rel="stylesheet" href="~/assets/css/style.css">

	<!--[if lt IE 9]>
		<script src="assets/js/html5shiv.min.js"></script>
		<script src="assets/js/respond.min.js"></script>
	<![endif]-->
</head>
<body>

	<!-- Main Wrapper -->
	<div class="main-wrapper">
		<div class="header">

			<!-- Header -->
			@Html.Partial("NurseHeader")
			<!-- /Header -->
		</div>
		<!-- Sidebar -->
		<div class="sidebar" id="sidebar">
			<div class="sidebar-inner slimscroll">
				@Html.Partial("SurgeonSideBar")
			</div>
		</div>
		<!-- /Sidebar -->
		<!-- Page Wrapper -->
		<div class="page-wrapper">
			<div class="content container-fluid">

				<!-- Page Header -->
				<div class="page-header">
					<div class="row">
						<div class="col">
							<h3 class="page-title">Add Patient Information</h3>
							<ul class="breadcrumb">
								<li class="breadcrumb-item"><a href="index.html">Dashboard</a></li>
								<li class="breadcrumb-item active">Patient Information</li>
							</ul>
						</div>
					</div>
				</div>
				<!-- /Page Header -->

				<div class="row">
					<div class="col-lg-12">
						<div class="card">

							<div class="card-body">
								<form asp-action="Create" class="needs-validation" novalidate=''>

									<div class="form-group row">
										<label class="col-form-label col-md-2">
											Title <span class="text-danger">*</span>
										</label>
										<div class="col-md-10">

											<select asp-for="Title" class="form-control">
												<option selected disabled value="">Please select</option>
												<option>Mr.</option>
												<option>Dr.</option>
												<option>Rev.</option>
												<option>Mrs.</option>
												<option>Miss.</option>
												<option>Ms.</option>
											</select>
											<span class="text invalid-feedback" style="width:100%">Title is Required</span>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">First Name<span class="text-danger">*</span> </label>
										<div class="col-md-10">
											<input class="form-control" asp-for="Name" type="text" required>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Last Name<span class="text-danger">*</span> </label>
										<div class="col-md-10">
											<input class="form-control" asp-for="Surname" type="text" required>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Mobile Number<span class="text-danger">*</span> </label>

										<div class="col-md-10">
											<input asp-for="ContactNumber" type="text" class="form-control" required>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Email<span class="text-danger">*</span> </label>

										<div class="col-md-10">
											<input class="form-control" asp-for="Email" type="email" required>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Date Of Birth<span class="text-danger">*</span> </label>

										<div class="col-md-10">
											<input asp-for="DateOfBirth" type="text" class="form-control" required>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Gender<span class="text-danger">*</span> </label>

										<div class="col-md-10">
											<select asp-for="Gender" class="form-control">
												<option selected disabled value="">Please select</option>
												<option>Male</option>
												<option>Female</option>

											</select>
										</div>
									</div>

									<div class="form-group row">
										<label class="col-form-label col-md-2">Address Line<span class="text-danger">*</span> </label>

										<div class="col-md-10">
											<input asp-for="AddressLine1" type="text" class="form-control" required>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Suburb Name<span class="text-danger">*</span> </label>

										<div class="col-md-10">
											<select asp-for="SuburbID" type="text" asp-items="@(new SelectList(ViewBag.SuburbID, "Value", "Text"))" class="form-control" required></select>

										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">City Name<span class="text-danger">*</span> </label>

										<div class="col-md-10">
											<select asp-for="CityID" type="text" asp-items="@(new SelectList(ViewBag.CityID, "Value", "Text"))" class="form-control" required></select>

										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Province Name<span class="text-danger">*</span> </label>

										<div class="col-md-10">
											<select asp-for="ProvinceID" type="text" asp-items="@(new SelectList(ViewBag.ProvinceID, "Value", "Text"))" class="form-control" required></select>

										</div>
									</div>
									<div class="form-group row">
										<div class="m-t-20 text-center">
											<button class="btn btn-primary submit-btn">Create Patient File</button>
										</div>
									</div>
								</form>
							</div>
						</div>

					</div>
				</div>

			</div>
		</div>
		<!-- /Main Wrapper -->

	</div>
	<!-- /Main Wrapper -->
	<!-- jQuery -->
	<script src="~/assets/js/jquery-3.2.1.min.js"></script>

	<!-- Bootstrap Core JS -->
	<script src="~/assets/js/popper.min.js"></script>
	<script src="~/assets/js/bootstrap.min.js"></script>

	<!-- Slimscroll JS -->
	<script src="~/assets/plugins/slimscroll/jquery.slimscroll.min.js"></script>

	<!-- Datatables JS -->
	<script src="~/assets/plugins/datatables/jquery.dataTables.min.js"></script>
	<script src="~/assets/plugins/datatables/datatables.min.js"></script>

	<!-- Custom JS -->
	<script src="~/assets/js/script.js"></script>

</body>

<!-- Mirrored from dreamguys.co.in/demo/doccure/admin/form-basic-inputs.html by HTTrack Website Copier/3.x [XR&CO'2014], Sat, 30 Nov 2019 04:12:54 GMT -->
</html>