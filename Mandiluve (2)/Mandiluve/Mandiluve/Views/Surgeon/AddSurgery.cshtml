@model Mandiluve.Models.Surgery
@inject IHttpContextAccessor httpContextAccessor
<!DOCTYPE html>
<html lang="en">

<!-- Mirrored from dreamguys.co.in/demo/doccure/admin/form-basic-inputs.html by HTTrack Website Copier/3.x [XR&CO'2014], Sat, 30 Nov 2019 04:12:54 GMT -->
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
	<title>Doccure - Patient List Page</title>

	<!-- Favicon -->
	<link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.png">

	<!-- Bootstrap CSS -->
	<link rel="stylesheet" href="~/assets/css/bootstrap.min.css">

	<!-- Fontawesome CSS -->
	<link rel="stylesheet" href="~/assets/css/font-awesome.min.css">

	<!-- Feathericon CSS -->
	<link rel="stylesheet" href="~/assets/css/feathericon.min.css">

	<!-- Datatables CSS -->
	<link rel="stylesheet" href="~/assets/plugins/datatables/datatables.min.css">

	<!-- Main CSS -->
	<link rel="stylesheet" href="~/assets/css/style.css">

	<!--[if lt IE 9]>
		<script src="assets/js/html5shiv.min.js"></script>
		<script src="assets/js/respond.min.js"></script>
	<![endif]-->
</head>
<body>

	<!-- Main Wrapper -->
	<div class="main-wrapper">
		<div class="header">

			<!-- Header -->
			@Html.Partial("NurseHeader")
			<!-- /Header -->
		</div>
		<!-- Sidebar -->
		<div class="sidebar" id="sidebar">
			<div class="sidebar-inner slimscroll">
				@Html.Partial("SurgeonSideBar")
			</div>
		</div>
		<!-- /Sidebar -->
		<!-- Page Wrapper -->
		<div class="page-wrapper">
			<div class="content container-fluid">

				<!-- Page Header -->
				<div class="page-header">
					<div class="row">
						<div class="col">
							<h3 class="page-title">Schedule Patient Surgery</h3>
							<ul class="breadcrumb">
								<li class="breadcrumb-item"><a href="index.html">Dashboard</a></li>
								<li class="breadcrumb-item"><a href="javascript:(0);">Patient</a></li>
								<li class="breadcrumb-item active">Patient Surgery</li>
							</ul>
						</div>
					</div>
				</div>
				<!-- /Page Header -->

				<div class="row">
					<div class="col-lg-12">
						<div class="card">

							<div class="card-body">
								<form asp-action="AddSurgery" class="needs-validation" novalidate=''>

									<div class="form-group row">
										<label class="col-form-label col-md-2">
											Patient Name <span class="text-danger">*</span>
										</label>
										<div class="col-md-10">

											<select asp-for="PatientID" type="text" asp-items="@(new SelectList(ViewBag.PatientID, "Value", "Text"))" class="form-control" required></select>

											<span class="text invalid-feedback" style="width:100%">Title is Required</span>
										</div>
									</div>

									<div class="form-group row">
										<label class="col-form-label col-md-2">Surgery Date<span class="text-danger">*</span> </label>
										<div class="col-md-10">
											<input class="form-control" asp-for="Date" type="date" required>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Time Slot<span class="text-danger">*</span> </label>
										<div class="col-md-10">
											<input asp-for="TimeSlot" type="time" class="form-control" required>
										</div>
									</div>

									<div class="form-group row">
										<label class="col-form-label col-md-2">Surgeon Name<span class="text-danger">*</span> </label>
										<div class="col-md-10">
											<input asp-for="UserID" type="text" value="@httpContextAccessor.HttpContext.Session.GetString("UserID")" class="form-control" required>

										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Anaesthesiologist Name<span class="text-danger">*</span> </label>
										<div class="col-md-10">
											<select asp-for="AnaesthesiologistID" type="text" asp-items="@(new SelectList(ViewBag.AnaesthesiologistID, "Value", "Text"))" class="form-control" required></select>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Theatre Name<span class="text-danger">*</span> </label>
										<div class="col-md-10">
											<select asp-for="TheatreID" type="text" asp-items="@(new SelectList(ViewBag.TheatreID, "Value", "Text"))" class="form-control" required></select>
										</div>
									</div>
									<div class="form-group row">
										<label class="col-form-label col-md-2">Treatment Code<span class="text-danger">*</span> </label>
										<div class="col-md-10">
											<select asp-for="CodeID" type="text" asp-items="@(new SelectList(ViewBag.CodeID, "Value", "Text"))" class="form-control" required></select>
										</div>
									</div>
									<div class="form-group row">
										<div class="m-t-20 text-center">
											<button class="btn btn-primary submit-btn">Schedule Patient Surgery </button>
										</div>
									</div>
								</form>
							</div>
						</div>

					</div>
				</div>

			</div>
		</div>
		<!-- /Main Wrapper -->

	</div>
	<!-- /Main Wrapper -->
	<!-- jQuery -->
	<script src="~/assets/js/jquery-3.2.1.min.js"></script>

	<!-- Bootstrap Core JS -->
	<script src="~/assets/js/popper.min.js"></script>
	<script src="~/assets/js/bootstrap.min.js"></script>

	<!-- Slimscroll JS -->
	<script src="~/assets/plugins/slimscroll/jquery.slimscroll.min.js"></script>

	<!-- Datatables JS -->
	<script src="~/assets/plugins/datatables/jquery.dataTables.min.js"></script>
	<script src="~/assets/plugins/datatables/datatables.min.js"></script>

	<!-- Custom JS -->
	<script src="~/assets/js/script.js"></script>

</body>

<!-- Mirrored from dreamguys.co.in/demo/doccure/admin/form-basic-inputs.html by HTTrack Website Copier/3.x [XR&CO'2014], Sat, 30 Nov 2019 04:12:54 GMT -->
</html>
